# Copy to api/.env for local development. Never commit real values.
ENV=local
ALLOWED_ORIGINS=http://localhost:3000

# AWS: a profile for YOUR personal account (not AWS_PROFILE, so a shell-wide profile never leaks in).
# In ECS leave this empty; the task role is used.
YAQIN_AWS_PROFILE=
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Supabase. Leave DATABASE_URL empty to serve content/ from memory.
DATABASE_URL=
SUPABASE_URL=https://<project-ref>.supabase.co
# Only for legacy HS256 projects:
SUPABASE_JWT_SECRET=

# Local only: treat anonymous requests as this role (learner | instructor | reviewer).
DEV_ROLE=
TUTOR_RATE_PER_MINUTE=12
