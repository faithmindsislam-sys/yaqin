# Copy to web/.env.local. These Supabase values are public browser configuration.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Older projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
# Production with /api routed to FastAPI: leave NEXT_PUBLIC_API_BASE empty.
# Use false for a CDN-only site before the backend is hosted; true for local/live API.
NEXT_PUBLIC_API_ENABLED=false
# Optional: where the Quran reader data lives (default: /data on this site). Set to the S3/CloudFront URL later.
NEXT_PUBLIC_QURAN_BASE=
